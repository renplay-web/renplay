worker_processes auto;
events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  sendfile off;
  tcp_nopush on;
  tcp_nodelay on;

  types {
    application/octet-stream data;
    application/octet-stream mem;
    application/octet-stream sav;
  }

  access_log /dev/stdout;
  error_log /dev/stderr;

  map $uri $cache_control {
    ~*\.(wasm|data|zip|mem)$ "public, immutable, max-age=31536000";
    ~*\.html$              "no-cache";
    default                "no-cache";
  }

  server {
    listen 8080;

    root /usr/share/nginx/html/selector;

    add_header X-Content-Type-Options "nosniff" always;

    location / {
      try_files $uri $uri/ /index.html;
    }

    location ~ ^/play/[^/]+$ {
      try_files $uri /index.html;
    }

    location /play/ {
      alias ${GAMES_DIR}/;
      index index.html;
      add_header X-Content-Type-Options "nosniff" always;
      add_header Cache-Control $cache_control;

      sub_filter '</head>' '<script src="/api/saves/sync-client.js"></script></head>';
      sub_filter_once on;
    }

    location /api/games {
      proxy_pass http://127.0.0.1:3000;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/saves/ {
      proxy_pass http://127.0.0.1:3000;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      client_max_body_size 100m;
    }

    location = /api/saves/sync-client.js {
      alias /usr/share/nginx/html/selector/sync-client.js;
      add_header X-Content-Type-Options "nosniff" always;
      add_header Cache-Control "no-cache";
    }

  }
}
